{
  "name": "@dfpunk/indexer-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared indexer core for dark-forest-aztec",
  "keywords": [],
  "license": "",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./TableTypes/chain": {
      "types": "./src/TableTypes/chain.ts",
      "import": "./src/TableTypes/chain.ts",
      "default": "./src/TableTypes/chain.ts"
    },
    "./TableTypes/enums": {
      "types": "./src/TableTypes/enums.ts",
      "import": "./src/TableTypes/enums.ts",
      "default": "./src/TableTypes/enums.ts"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "del-cli dist node_modules",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test": "node --test --experimental-transform-types src/*.test.ts"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.2.0",
    "@aztec/constants": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@dfpunk/contracts": "workspace:*"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c"
}
